NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/simplifica_ai

REDIS_URL=redis://localhost:6379

JWT_SECRET=troque-por-uma-string-aleatoria-de-pelo-menos-32-caracteres
JWT_EXPIRES_IN=7d

# Obtenha GRÁTIS em: https://console.groq.com → API Keys
# Não precisa de cartão de crédito!
GROQ_API_KEY=gsk_...
# Modelos disponíveis: llama-3.3-70b-versatile, llama-3.1-8b-instant (mais rápido)
GROQ_MODEL=llama-3.3-70b-versatile

FREE_DAILY_LIMIT=5
MAX_TEXT_LENGTH=10000

ALLOWED_ORIGIN=https://seudominio.com
